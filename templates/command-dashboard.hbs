<section class="w4sq-command">
  <header>
    <div class="header-top">
      <div class="header-main">
        <h2>{{localize "W4SQ.CommandDashboard"}}</h2>
        {{#if dispositionLabel}}
          <p class="group-label">{{dispositionLabel}}</p>
        {{/if}}
        {{#if commander}}
          <p>{{localize "W4SQ.Commander"}}: {{commander.name}}</p>
          <div class="cp-bar">
            <span>{{localize "W4SQ.CP"}}: {{cp.current}} / {{cp.cap}}</span>
            {{#if commander.canAdjustCP}}
              <span class="cp-controls">
                <button type="button" data-cp-action="delta" data-delta="1" title="{{localize "W4SQ.CPPlus"}}">+1</button>
                <button type="button" data-cp-action="delta" data-delta="-1" title="{{localize "W4SQ.CPMinus"}}">-1</button>
                <button type="button" data-cp-action="set" data-value="cap" title="{{localize "W4SQ.CPRefill"}}">⟳</button>
              </span>
            {{/if}}
          </div>
        {{else}}
          <p>{{localize "W4SQ.NoCommander"}}</p>
        {{/if}}
      </div>

      <div class="strength-summary" aria-label="{{localize 'W4SQ.StrengthAriaLabel'}}">
        <p class="strength-title">{{localize "W4SQ.StrengthTotals"}}</p>
        <div class="strength-values">
          <span class="strength-entry allied">{{localize "W4SQ.StrengthAllied"}}: {{strength.allied.current}}</span>
          <span class="strength-entry hostile">{{localize "W4SQ.StrengthHostile"}}: {{strength.hostile.current}}</span>
        </div>
        <div class="strength-bar" role="presentation">
          <span class="segment allied" style="width: {{strength.alliedPct}}%"></span>
          <span class="segment hostile" style="width: {{strength.hostilePct}}%"></span>
        </div>
      </div>
    </div>
  </header>

  <div class="command-buttons">
    <button data-command="cmd-ranged">{{localize "W4SQ.CmdRanged"}}</button>
    <button data-command="cmd-orders">{{localize "W4SQ.CmdOrders"}}</button>
    <button data-command="cmd-rally">{{localize "W4SQ.CmdRally"}}</button>
    <button data-command="cmd-withdraw">{{localize "W4SQ.CmdWithdraw"}}</button>
    <button data-command="cmd-intercept">{{localize "W4SQ.CmdIntercept"}}</button>
    <button data-command="cmd-special">{{localize "W4SQ.CmdSpecial"}}</button>
    <button data-command="cmd-formation">{{localize "W4SQ.CmdFormation"}}</button>
  </div>

  {{#*inline "w4sq-squad-table"}}
    <table class="squad-table">
      <thead>
        <tr>
          <th></th>
          <th>{{localize "W4SQ.Squad"}}</th>
          <th>{{localize "W4SQ.HP"}}</th>
          <th>{{localize "W4SQ.Morale"}}</th>
          <th>{{localize "W4SQ.ActiveEffects"}}</th>
          <th>{{localize "W4SQ.Cooldowns"}}</th>
          <th>{{localize "W4SQ.LastTarget"}}</th>
          {{#if @root.showOwnerControls}}
            <th>{{localize "W4SQ.Owner"}}</th>
          {{/if}}
          <th>{{localize "W4SQ.ManeuverFlag"}}</th>
          <th>{{localize "W4SQ.Orders"}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each squads as |squad|}}
          <tr class="{{#if squad.isSelected}}selected{{/if}}">
            <td><button data-action="select" data-id="{{squad.id}}">{{localize "W4SQ.Select"}}</button></td>
            <td>{{squad.name}}{{#if squad.binding}}<div class="binding-state">{{squad.binding.label}}{{#if squad.binding.crumbling}} · {{squad.binding.crumblingLabel}}{{/if}}</div>{{/if}}</td>
            <td>
              <div class="bar">
                <div class="fill" style="width: {{squad.hpPct}}%"></div>
              </div>
              <span>{{squad.hp}} / {{squad.hpMax}}</span>
            </td>
            <td>
              <div class="bar morale">
                <div class="fill" style="width: {{squad.moralePct}}%"></div>
              </div>
              <span>{{squad.morale}} / {{squad.moraleMax}}</span>
            </td>
            <td>
              {{#if squad.effects.length}}
                <div class="effect-list">
                  {{#each squad.effects as |eff|}}
                    <span class="effect-chip {{eff.polarity}}" data-summary="{{eff.summary}}" data-label="{{eff.label}}">{{eff.label}} ({{eff.durationLabel}})</span>
                  {{/each}}
                </div>
              {{else}}
                <span>{{localize "W4SQ.None"}}</span>
              {{/if}}
            </td>
            <td>
              {{#each squad.cooldowns as |cooldown|}}
                <span class="badge cooldown">{{cooldown.label}}: {{cooldown.turnsLabel}}</span>
              {{else}}
                <span>{{localize "W4SQ.None"}}</span>
              {{/each}}
            </td>
            <td>{{squad.lastTargetName}}</td>
            {{#if @root.showOwnerControls}}
              <td class="owner-cell">
                <select class="w4sq-owner-select" data-actor-id="{{squad.actorId}}" data-token-id="{{squad.tokenId}}">
                  {{#each @root.ownerOptions as |opt|}}
                    <option value="{{opt.value}}" {{#if (eq opt.value squad.commanderUserId)}}selected{{/if}}>{{opt.label}}</option>
                  {{/each}}
                </select>
              </td>
            {{/if}}
            <td class="maneuver-flag">
              {{#if squad.canReceiveOrders}}
                <label class="maneuver-toggle" title="{{localize "W4SQ.OrderManeuverToggle"}}">
                  <input type="checkbox" data-order-maneuver data-token-id="{{squad.id}}" aria-label="{{localize "W4SQ.OrderManeuverToggle"}}" {{#if squad.maneuverChecked}}checked{{/if}} />
                </label>
              {{else}}
                <span class="orders-disabled">—</span>
              {{/if}}
            </td>
            <td>
              {{#if squad.canReceiveOrders}}
                <div class="order-controls">
                  <select data-order-select data-token-id="{{squad.tokenId}}" data-actor-id="{{squad.actorId}}">
                    {{#each @root.orderOptions as |opt|}}
                      <option value="{{opt.value}}" {{#if (eq opt.value squad.order)}}selected{{/if}}>{{opt.label}}</option>
                    {{/each}}
                  </select>
                </div>
              {{else}}
                <span class="orders-disabled">{{localize "W4SQ.CommanderNoOrders"}}</span>
              {{/if}}
            </td>
          </tr>
        {{else}}
          <tr>
            <td colspan="{{#if @root.showOwnerControls}}10{{else}}9{{/if}}">{{localize "W4SQ.NoSquads"}}</td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{/inline}}

  {{#if useBuckets}}
    {{#if buckets.length}}
      {{#each buckets as |bucket|}}
        <section class="w4sq-bucket" data-user="{{bucket.id}}">
          <h3>{{bucket.label}}</h3>
          {{> w4sq-squad-table squads=bucket.squads}}
        </section>
      {{/each}}
    {{else}}
      <p class="w4sq-no-squads">{{localize "W4SQ.NoSquads"}}</p>
    {{/if}}
  {{else}}
    {{> w4sq-squad-table squads=squads}}
  {{/if}}

  <div class="fob-menu">
    <div class="fob-header">
      <p class="title">{{localize "W4SQ.FobMenu"}}</p>
      <label>
        {{localize "W4SQ.FobTreasury"}}
        <input type="number" min="0" data-treasury-input value="{{treasury}}" />
      </label>
    </div>
    <div class="fob-actions">
      <button type="button" data-fob-action="rest">{{localize "W4SQ.FobRest"}}</button>
      <button type="button" data-fob-action="restore">{{localize "W4SQ.FobRestore"}}</button>
      <button type="button" data-fob-action="upkeep">{{localize "W4SQ.FobUpkeep"}}</button>
      <button type="button" data-fob-action="clear-effects">{{localize "W4SQ.FobClearEffects"}}</button>
    </div>
  </div>
</section>
